# Default: ingest and expose online stores only for Rami Levy, Carrefour, Shufersal, Victory
ONLINE_ONLY=true
# --- אחסון ---
# sqlite = הרצה מקומית בלי Postgres וללא Docker (קובץ אחד). pg = Postgres (production).
# בלי DB_DRIVER: אם DATABASE_URL מוגדר משתמשים ב-pg, אחרת ב-sqlite.
# DB_DRIVER=sqlite
# SQLITE_PATH=data/prices.db
# DB_DRIVER=pg
# DATABASE_URL=postgres://prices:prices@localhost:5432/prices
# כשה-web רץ על origin אחר מה-API (ברירת מחדל לא צריך: ה-proxy מטפל בזה)
# CORS_ORIGIN=http://localhost:5173
PORT=3000
# API: background pull on every startup + same daily cron as scheduler
API_INGEST_ON_START=true
API_INGEST_SCHEDULED=true
# If a separate scheduler owns refresh, set API_INGEST_SCHEDULED=false.
# Set both false to disable all API-triggered network ingestion.
# סף דמיון (pg_trgm) לחיבור אוטומטי של מוצרים בלי ברקוד
FUZZY_AUTO_THRESHOLD=0.8
# בין הסף הזה לסף האוטומטי: מוצר חדש + סימון לבדיקה ידנית
FUZZY_REVIEW_THRESHOLD=0.55
MAX_PRICE_ILS=10000
MAX_FILE_AGE_HOURS=36

# --- קליטה יומית (שירות scheduler) ---
# שעה ודקה לפי אזור הזמן. ברירת מחדל 06:00 שעון ישראל, אחרי שהרשתות מפרסמות
INGEST_HOUR=6
INGEST_MINUTE=0
INGEST_TZ=Asia/Jerusalem
# ביטוי cron מלא במקום שעה/דקה (אופציונלי), למשל "0 */6 * * *"
# INGEST_CRON=
# true = ריצה אחת מיד בעליית השירות
INGEST_RUN_ON_START=false
INGEST_RETRY_ATTEMPTS=3
INGEST_RETRY_BASE_SECONDS=60

# --- MCP מרחוק (HTTP) ---
MCP_PORT=3001
MCP_HOST=127.0.0.1
# מומלץ מאוד לכל שימוש מעבר ל-localhost
MCP_AUTH_TOKEN=
